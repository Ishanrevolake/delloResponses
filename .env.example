# Copy the relevant values into .env.local and your deployment's secret settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Existing email integration (required only for sending reviewed replies).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Background automation (server-only; never prefix these with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Set true only when the automation migration, SMTP and scheduler are ready.
AUTOMATION_SEND_ENABLED=false
# Used only by npm run automation:local; set to your local server URL.
AUTOMATION_BASE_URL=http://127.0.0.1:3000
# Select one provider. There is no automatic fallback to a paid provider.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Client data API: server-side only. The raw client token belongs in the private handoff file.
CLIENT_API_KEY_HASH=
CLIENT_API_WEBSITE_ID=
CLIENT_API_KEY_EXPIRES_AT=
